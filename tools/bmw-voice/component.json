{
  "id": "bmw-voice",
  "kind": "tool",
  "version": "1.1.0",
  "title": "Trợ lý Giọng nói BMW (Tiếng Việt)",
  "description": "Thay thế Trợ lý Giọng nói nguyên bản BMW Intelligent Personal Assistant trên MGU iDrive 7 (SP18): hỗ trợ gọi rảnh tay \"Hey BMW\" và bấm nút Mic vô-lăng hiện ngay giao diện trợ lý chuẩn BMW đè trên mọi màn hình (kể cả CarPlay), điều khiển điều hoà, ghế, đèn viền, âm lượng/nhạc, cửa kính và thông số xe bằng Tiếng Việt.",
  "license": "GPL-3.0-or-later",
  "mguHmi": [
    "ID7"
  ],
  "uninstallable": true,
  "requires": {
    "mgu-deploy": "0.7.11",
    "mgu-python": "1.0.2"
  },
  "files": [
    {
      "path": "bmw-voice.js",
      "mode": "0644"
    },
    {
      "path": "car-control.js",
      "mode": "0644"
    },
    {
      "path": "nlu-brain.js",
      "mode": "0644"
    },
    {
      "path": "mic-capture.js",
      "mode": "0644"
    },
    {
      "path": "ipa-overlay.js",
      "mode": "0644"
    },
    {
      "path": "alsa-smartx.py",
      "mode": "0755"
    },
    {
      "path": "uplink.js",
      "mode": "0644"
    },
    {
      "path": "page.html",
      "mode": "0644"
    },
    {
      "path": "fonts/vietnamese.json",
      "mode": "0644"
    },
    {
      "path": "fonts/vietnamese-bold.json",
      "mode": "0644"
    },
    {
      "path": "fonts/OFL-Inter.txt",
      "mode": "0644"
    },
    {
      "path": "LICENSE.GPL-3.0",
      "mode": "0644"
    }
  ],
  "units": [
    {
      "name": "bmw-voice.service"
    }
  ],
  "enable": [
    {
      "unit": "bmw-voice.service",
      "target": "oapcontroller.service"
    }
  ],
  "recmgr": [
    "bmw-voice"
  ],
  "restart": [
    "bmw-voice.service"
  ],
  "deactivate": [
    "node",
    "bmw-voice.js",
    "fwclose"
  ],
  "internet": true,
  "uids": "state/internet-uids"
}
